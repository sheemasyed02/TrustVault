# Copy to .env.local for local development, or set in the Vercel project
# Environment Variables UI for Production / Preview.
#
# Must be an absolute http(s) URL of the FastAPI API (no trailing slash required).
# Must also appear in the backend CORS_ORIGINS allow-list.
#
# Local:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#
# Production example (Render API URL):
# NEXT_PUBLIC_API_BASE_URL=https://trustvault-api.onrender.com
#
# Never put DATABASE_URL, JWT_SECRET_KEY, or R2 secret keys in frontend env.
