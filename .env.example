# Root placeholders for local orchestration. Prefer app-specific env files:
# - frontend/.env.local  (from frontend/.env.example) → NEXT_PUBLIC_API_BASE_URL
# - backend/.env         (from backend/.env.example)  → DATABASE_URL, JWT_*, R2_*, CORS_ORIGINS
#
# Production:
# - Vercel: NEXT_PUBLIC_API_BASE_URL only
# - Render: see backend/.env.example and render.yaml (secrets in dashboard)
#
# Never commit real secrets.

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
