# Copy to .env and fill in local values. Never commit real secrets.
APP_ENV=development
API_PREFIX=/api/v1

# Comma-separated browser origins (scheme + host + port). No wildcards.
# Local:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example (replace with your real Vercel URL):
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# PostgreSQL (required)
# ---------------------------------------------------------------------------
# Driver: sync psycopg v3. The app normalizes these schemes to postgresql+psycopg://
#   postgresql://...
#   postgres://...
#   postgresql+psycopg://...
#   postgresql+asyncpg://...  (remapped)
# Keep Neon query params (sslmode, channel_binding). Do not strip SSL settings.
#
# Neon guidance:
# - DATABASE_URL — application traffic (pooled "-pooler" URL is OK for this API).
# - DIRECT_URL   — optional; preferred for Alembic migrations (non-pooler / direct).
#                 When unset, Alembic uses DATABASE_URL.
# - Never point pytest at production (see TEST_DATABASE_URL below).
#
# Local example:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/trustvault_db
# DIRECT_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/trustvault_db

# Pytest ONLY — dedicated database whose name contains "test".
# Never point this at Neon production (e.g. neondb). Tests refuse to start if unset
# and never silently fall back to DATABASE_URL.
#   1) CREATE DATABASE trustvault_test;
#   2) Set TEST_DATABASE_URL
#   3) $env:DATABASE_URL=$env:TEST_DATABASE_URL; alembic upgrade head
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/trustvault_test
# TRUSTVAULT_ALLOW_REMOTE_TEST_DB=1

# ---------------------------------------------------------------------------
# JWT access tokens (required for login / protected routes)
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ISSUER=trustvault
JWT_AUDIENCE=trustvault-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Development-only demo seed (python -m app.cli.seed_demo_users)
# ---------------------------------------------------------------------------
# Never set these on Render production unless you intentionally run the seed CLI.
# The API does NOT auto-seed on startup.
DEMO_ADMIN_PASSWORD=change-me-admin-password
DEMO_OWNER_PASSWORD=change-me-owner-password
DEMO_VIEWER_PASSWORD=change-me-viewer-password

# ---------------------------------------------------------------------------
# Cloudflare R2 (private bucket — downloads only via authorized API)
# ---------------------------------------------------------------------------
# Endpoint form: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=trustvault-documents
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
