# Copy to .env and fill in local values. Never commit real secrets.
APP_ENV=development
API_PREFIX=/api/v1
# Include every origin the Next.js app may use (scheme + host + port).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required PostgreSQL connection string (loaded from this file by pydantic-settings).
# Driver: sync psycopg v3 (package: psycopg[binary]). SQLAlchemy/Alembic use:
#   postgresql+psycopg://...
#
# Paste Neon/Railway/local URLs as either of these; the app normalizes the scheme:
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
#   postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
# Also accepted: postgres://... and postgresql+asyncpg://... (remapped to psycopg).
# Keep Neon query params (sslmode, channel_binding). Do not strip SSL settings.
#
# Neon:
# - Prefer the DIRECT connection string for Alembic migrations.
# - Pooled (-pooler) URLs are optional for app traffic; this app uses short
#   request-scoped sessions and is generally pooler-compatible.
# - Put the real URL only in backend/.env (gitignored) or the host's secret env.
# - Verify with: python scripts/check_database_connection.py
#
# Local example:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/trustvault_db

# Pytest ONLY — never point this at your Neon/production database name (e.g. neondb).
# Prefer a dedicated local database. Tests refuse to start if this is unset, and
# they never silently fall back to DATABASE_URL.
#   1) CREATE DATABASE trustvault_test;
#   2) Set TEST_DATABASE_URL (below)
#   3) $env:DATABASE_URL=$env:TEST_DATABASE_URL; alembic upgrade head
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/trustvault_test
# Remote isolated test DBs are blocked unless you explicitly opt in:
# TRUSTVAULT_ALLOW_REMOTE_TEST_DB=1

# Optional alternate URL for scripts/migrate_with_url_env.py (not used by the API).
# RAILWAY_DATABASE_URL=

# JWT access tokens (required for login / protected routes)
# Generate a long random value locally, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real secret.
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ISSUER=trustvault
JWT_AUDIENCE=trustvault-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Development-only demo seed passwords (used by: python -m app.cli.seed_demo_users)
# Do not use these in production. Never commit real passwords.
DEMO_ADMIN_PASSWORD=change-me-admin-password
DEMO_OWNER_PASSWORD=change-me-owner-password
DEMO_VIEWER_PASSWORD=change-me-viewer-password

# Cloudflare R2 (private bucket only — never commit real credentials)
# Endpoint form: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=trustvault-documents
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
