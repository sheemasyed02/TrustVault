# Copy to .env and fill in local values. Never commit real secrets.
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Database (not wired in this scaffold)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/trustvault

# Auth secrets (not wired in this scaffold)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudflare R2 (not wired in this scaffold)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
